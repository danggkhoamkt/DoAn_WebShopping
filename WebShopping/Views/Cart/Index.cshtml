@model List<WebShopping.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var total = Model.Sum(x => x.LineTotal);
}
<div class="cart_area section_padding_100 clearfix">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="row">
            <div class="col-12">
                <div class="cart-table clearfix">
                    <table class="table table-responsive">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4">Giỏ hàng đang trống.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="cart_product_img d-flex align-items-center">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="~/client/img/product-img/@item.ImageUrl" alt="@item.ProductName">
                                                }
                                            </a>
                                            <h6>
                                                @item.ProductName
                                                <br />
                                                <a asp-action="Remove" asp-route-productId="@item.ProductId" class="text-danger"
                                                   style="font-size:12px;">Xóa</a>
                                            </h6>
                                        </td>
                                        <td class="price"><span>@item.UnitPrice.ToString("N0") đ</span></td>
                                        <td class="qty">
                                            <form asp-action="Update" method="post" class="d-flex align-items-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="number" class="qty-text" name="quantity" min="1" max="99"
                                                       value="@item.Quantity" />
                                                <button type="submit" class="btn btn-sm btn-outline-dark ml-2">Cập nhật</button>
                                            </form>
                                        </td>
                                        <td class="total_price"><span>@item.LineTotal.ToString("N0") đ</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="cart-footer d-flex mt-30">
                    <div class="back-to-shop w-50">
                        <a asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a>
                    </div>
                    <div class="update-checkout w-50 text-right">
                        <a asp-action="Clear">Xóa giỏ hàng</a>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.Any())
        {
            <div class="row">
                <div class="col-12 col-lg-4 ml-auto">
                    <div class="cart-total-area mt-70">
                        <div class="cart-page-heading">
                            <h5>Tổng giỏ hàng</h5>
                            <p>Thông tin cuối</p>
                        </div>
                        <ul class="cart-total-chart">
                            <li><span>Tạm tính</span> <span>@total.ToString("N0") đ</span></li>
                            <li><span>Vận chuyển</span> <span>Miễn phí</span></li>
                            <li><span><strong>Tổng</strong></span> <span><strong>@total.ToString("N0") đ</strong></span>
                            </li>
                        </ul>
                        <a asp-action="Checkout" class="btn karl-checkout-btn">Tiến hành đặt hàng</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>