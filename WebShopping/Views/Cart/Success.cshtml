@model WebShopping.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}
<div class="container section_padding_100">
    <div class="text-center mb-5">
        <h3>Cảm ơn bạn đã đặt hàng!</h3>
        <p>Mã đơn hàng: <strong>#@Model.OrderId</strong></p>
        <p>Chúng tôi sẽ liên hệ @Model.CustomerName qua số @Model.PhoneNumber để xác nhận.</p>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                <tr>
                    <td>@(d.Product?.ProductName ?? ("#" + d.ProductId))</td>
                    <td>@d.UnitPrice.ToString("N0") đ</td>
                    <td>@d.Quantity</td>
                    <td>@((d.UnitPrice * d.Quantity).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-right">Tổng cộng</th>
                <th>@Model.TotalAmount.ToString("N0") đ</th>
            </tr>
        </tfoot>
    </table>
    <div class="text-center">
        <a asp-controller="Home" asp-action="Index" class="btn karl-checkout-btn">Về trang chủ</a>
    </div>
</div>