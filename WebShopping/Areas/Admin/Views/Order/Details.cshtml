@model WebShopping.Models.Order
@using WebShopping.Helpers
@using WebShopping.Models
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}
<h1 class="page-header">Đơn hàng #@Model.OrderId</h1>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<div class="row">
    <div class="col-lg-6">
        <div class="panel panel-default">
            <div class="panel-heading">Thông tin khách hàng</div>
            <div class="panel-body">
                <p><strong>Họ tên:</strong> @Model.CustomerName</p>
                <p><strong>Điện thoại:</strong> @Model.PhoneNumber</p>
                <p><strong>Địa chỉ:</strong> @Model.Address</p>
                <p><strong>Ghi chú:</strong> @(Model.Note ?? "-")</p>
                <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p>
                    <strong>Trạng thái:</strong>
                    <span
                    class="@OrderStatusHelper.CssClass(Model.Status)">@OrderStatusHelper.ToVietnamese(Model.Status)</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel panel-default">
            <div class="panel-heading">Cập nhật trạng thái</div>
            <div class="panel-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <div class="form-group">
                        <select name="status" class="form-control">
                            @foreach (OrderStatus st in Enum.GetValues(typeof(OrderStatus)))
                            {
                                if (st == Model.Status)
                                {
                                    <option value="@st" selected>@OrderStatusHelper.ToVietnamese(st)</option>
                                }
                                else
                                {
                                    <option value="@st">@OrderStatusHelper.ToVietnamese(st)</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu trạng thái</button>
                    <a asp-action="Index" class="btn btn-default">Danh sách</a>
                </form>
            </div>
        </div>
    </div>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Đơn giá lúc đặt</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.OrderDetails)
        {
            <tr>
                <td>@(d.Product?.ProductName ?? ("#" + d.ProductId))</td>
                <td>@d.UnitPrice.ToString("N0") đ</td>
                <td>@d.Quantity</td>
                <td>@((d.UnitPrice * d.Quantity).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-right">Tổng tiền</th>
            <th>@Model.TotalAmount.ToString("N0") đ</th>
        </tr>
    </tfoot>
</table>